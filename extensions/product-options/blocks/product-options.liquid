{
  "name": "Product options",
  "target": "section",
  "stylesheet": "product-options.css",
  "javascript": "product-options.js",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_price_summary",
      "label": "Show live price add-on summary",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customize this product"
    }
  ]
}
